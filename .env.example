# Beispiel-Umgebungsvariablen (Vorlage – diese Datei DARF eingecheckt werden).
# Echte Werte in eine NICHT eingecheckte ".env" kopieren (siehe .gitignore).
#
# WICHTIG: Diese App ist eine statische PWA OHNE Build-Step. Zur Laufzeit wird
# KEINE .env gelesen – die Konfiguration steht in src/config.js (Supabase-URL +
# Publishable Key sind öffentlich, der Schutz läuft über RLS). Diese Datei
# dokumentiert die nötigen Werte und dient als Vorlage, falls später ein Bundler
# (z.B. Vite) ergänzt wird, der import.meta.env nutzt.

# Supabase Projekt-URL
VITE_SUPABASE_URL=https://aaiubbokbcezeazeycer.supabase.co

# Supabase PUBLISHABLE / anon Key (öffentlich – KEIN service_role/secret Key!)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# App-URL (für Auth-Redirects). Leer lassen = automatisch aus window.location.
#   lokal:      http://localhost:8080
#   production: https://<user>.github.io/nebeneinkuenfte/  (bzw. echte Domain)
VITE_APP_URL=

# NIEMALS hier oder im Frontend: SUPABASE_SERVICE_ROLE_KEY / sb_secret_...
